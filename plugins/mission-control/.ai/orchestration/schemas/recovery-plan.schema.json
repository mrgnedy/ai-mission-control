{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "workflow_id", "expected_revision_count", "state_updated_at", "unavailable_providers", "routes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "expected_revision_count": {"type": "integer", "minimum": 0},
    "state_updated_at": {"type": "string", "minLength": 1},
    "unavailable_providers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "restore_provider": {"type": "string", "minLength": 1},
    "availability_confirmed": {"type": "boolean"},
    "availability_evidence": {"type": ["string", "null"]},
    "routes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_profile", "from_status", "attempts", "to_profile", "reason", "changed_files", "worktree_head", "worktree_snapshot", "partial_reviewed"],
        "properties": {
          "from_profile": {"type": "string", "minLength": 1},
          "from_status": {"enum": ["pending", "ready", "blocked", "failed"]},
          "attempts": {"type": "integer", "minimum": 0},
          "to_profile": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "changed_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "worktree_head": {"type": ["string", "null"]},
          "worktree_snapshot": {"type": "object", "additionalProperties": {"type": "string"}},
          "partial_reviewed": {"type": "boolean"}
        }
      }
    }
  }
}
