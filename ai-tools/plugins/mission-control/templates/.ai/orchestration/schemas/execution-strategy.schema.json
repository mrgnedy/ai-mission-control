{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/orchestration/execution-strategy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "allowed_worker_providers", "parallel_worktree_providers", "routing_matrix"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "allowed_worker_providers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
    "parallel_worktree_providers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
    "routing_matrix": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*\\.yaml$"}
  }
}
