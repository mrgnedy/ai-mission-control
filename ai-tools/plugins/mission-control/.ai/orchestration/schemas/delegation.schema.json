{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/orchestration/delegation.schema.json",
  "title": "Task delegation matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "execution_plan"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "workflow_id": {"type": "string"},
    "execution_plan": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "executor", "isolation", "reason"],
        "properties": {
          "profile": {"type": "string"},
          "executor": {"type": "string", "minLength": 1},
          "isolation": {"enum": ["workspace", "worktree", "read_only"]},
          "model": {"type": ["string", "null"]},
          "effort": {"type": ["string", "null"]},
          "timeout_seconds": {"type": "integer", "minimum": 1},
          "max_attempts": {"type": "integer", "minimum": 1},
          "reason": {"type": "string", "minLength": 1},
          "fallbacks": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["profile", "reason"], "properties": {"profile": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}}
        }
      }
    }
  }
}
