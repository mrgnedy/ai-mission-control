{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/orchestration/task-graph.schema.json",
  "title": "Implementation task graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow", "parallelization", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objective"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "objective": {"type": "string", "minLength": 1},
        "max_remediation_cycles": {"type": "integer", "minimum": 0}
      }
    },
    "parallelization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_workers", "require_non_overlapping_scope"],
      "properties": {
        "enabled": {"type": "boolean"},
        "max_workers": {"type": "integer", "minimum": 1},
        "require_non_overlapping_scope": {"type": "boolean"}
      }
    },
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "task.schema.json"}}
  }
}
