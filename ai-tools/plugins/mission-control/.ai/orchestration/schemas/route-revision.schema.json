{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "sequence", "created_at", "plan_path", "plan", "routes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "minLength": 1},
    "plan_path": {"type": "string", "minLength": 1},
    "plan": {"$ref": "recovery-plan.schema.json"},
    "routes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_profile", "to_route"],
        "properties": {
          "from_profile": {"type": "string", "minLength": 1},
          "to_route": {
            "type": "object", "additionalProperties": false,
            "required": ["profile", "executor", "isolation", "reason", "timeout_seconds", "max_attempts"],
            "properties": {
              "profile": {"type": "string", "minLength": 1},
              "executor": {"type": "string", "minLength": 1},
              "isolation": {"enum": ["workspace", "worktree", "read_only"]},
              "model": {"type": ["string", "null"]},
              "effort": {"type": ["string", "null"]},
              "timeout_seconds": {"type": "integer", "minimum": 1},
              "max_attempts": {"type": "integer", "minimum": 1},
              "reason": {"type": "string", "minLength": 1},
              "fallbacks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["profile", "reason"], "properties": {"profile": {"type": "string"}, "reason": {"type": "string"}}}}
            }
          }
        }
      }
    }
  }
}
